                    DNRV = GICT (CICF, 0x06)
                    If ((DNRV != Ones))
                    {
                        ADBG (Concatenate ("NV D-Notify =", ToHexString (DNRV)))
                        Local0 = DNRV /* \_SB_.PC00.LPCB.EC__.HKEY.NVDN.DNRV */
                    }
                    Else
                    {
                        Local0 = LDST /* \_SB_.PC00.LPCB.EC__.HKEY.LDST */
