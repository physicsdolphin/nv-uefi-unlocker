                    Local0 = ^H_EC.ERB1 ()
                    ^H_EC.BNUM = ((Local0 & 0x08) >> 0x03)
                    ADBG (Concatenate ("BNUM resume from Sx: ", ToHexString (^H_EC.BNUM)))
