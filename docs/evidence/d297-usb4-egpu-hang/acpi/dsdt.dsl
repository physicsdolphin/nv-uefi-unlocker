            })
            Method (WMRQ, 3, NotSerialized)
            {
                Acquire (^^WMI1.MWMI, 0xFFFF)
                RQBF = Arg2
                WMIS (0x16, Zero)
                Release (^^WMI1.MWMI)
                Return (RQSC) /* \RQSC */
            }

            Method (WMRP, 3, NotSerialized)
            {
                Acquire (^^WMI1.MWMI, 0xFFFF)
                WMIS (0x16, One)
                Release (^^WMI1.MWMI)
                Return (RPRT) /* \RPRT */
            }

            Method (WMLQ, 3, NotSerialized)
            {
                Acquire (^^WMI1.MWMI, 0xFFFF)
                EQBF = Arg2
                WMIS (0x16, 0x02)
                Release (^^WMI1.MWMI)
                Return (EQRT) /* \EQRT */
            }

            Method (WMLP, 3, NotSerialized)
            {
                Acquire (^^WMI1.MWMI, 0xFFFF)
                CreateByteField (Arg2, Zero, ERQ1)
                CreateByteField (Arg2, One, ERQ2)
                EPIN = ERQ1 /* \_SB_.WMI8.WMLP.ERQ1 */
                EPSN = ERQ2 /* \_SB_.WMI8.WMLP.ERQ2 */
                WMIS (0x16, 0x03)
                Release (^^WMI1.MWMI)
                Return (EPRT) /* \EPRT */
            }

            Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
            {
                If ((Arg0 == 0xD0))
                {
                    Return (Arg0)
                }

                Return (Zero)
            }

