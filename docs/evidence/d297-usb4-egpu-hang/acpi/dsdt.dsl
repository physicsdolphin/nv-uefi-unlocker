        Device (WMI9)
        {
            Name (_HID, EisaId ("PNP0C14") /* Windows Management Instrumentation Device */)  // _HID: Hardware ID
            Name (_UID, "GMZN")  // _UID: Unique ID
            Name (_WDG, Buffer (0x28)
            {
                /* 0000 */  0x05, 0x88, 0x2A, 0xDC, 0x8C, 0x3A, 0xBA, 0x41,  // ..*..:.A
                /* 0008 */  0xA6, 0xF7, 0x09, 0x2E, 0x00, 0x89, 0xCD, 0x3B,  // .......;
                /* 0010 */  0x4C, 0x41, 0x01, 0x02, 0x21, 0x12, 0x90, 0x05,  // LA..!...
                /* 0018 */  0x66, 0xD5, 0xD1, 0x11, 0xB2, 0xF0, 0x00, 0xA0,  // f.......
                /* 0020 */  0xC9, 0x06, 0x29, 0x10, 0x43, 0x45, 0x01, 0x00   // ..).CE..
            })
            Name (CMDF, One)
            Method (WMLA, 3, NotSerialized)
            {
                Acquire (^^WMI1.MWMI, 0xFFFF)
                If ((Arg1 == 0x63))
                {
                    If ((CMDF == Zero))
                    {
                        CMDF = One
                        Release (^^WMI1.MWMI)
                        Return (TACI) /* \TACI */
                    }

                    If ((SizeOf (Arg2) > 0x64))
                    {
                        Name (TMPB, Buffer (0x64){})
                        TMPB = Arg2
                        TACI = TMPB /* \_SB_.WMI9.WMLA.TMPB */
                    }
                    Else
                    {
                        TACI = Arg2
                    }

                    Local0 = WMIS (0x17, Zero)
                    Local1 = 0x04
                    Local2 = Zero
                    If ((Local0 == Zero))
                    {
                        While (((Local1 == 0x04) && (Local2 < 0x06)))
                        {
                            Sleep (0x19)
                            Local2++
                            Local1 = WMIS (0x17, One)
                        }
                    }

                    CMDF = Zero
                }

                Release (^^WMI1.MWMI)
                Return (TACI) /* \TACI */
            }

