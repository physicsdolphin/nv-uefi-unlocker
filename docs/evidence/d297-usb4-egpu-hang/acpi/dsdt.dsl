            {
                Package (0x06)
                {
                    0x04F3, 
                    0x3195, 
                    0x15, 
                    One, 
                    One, 
                    "ELAN0676"
                }, 

                Package (0x06)
                {
                    0x04F3, 
                    0x320B, 
                    0x15, 
                    One, 
                    One, 
                    "ELAN0683"
                }, 

                Package (0x06)
