            Method (UHMS, 0, NotSerialized)
            {
                Local0 = Zero
                Local1 = SizeOf (ITML)
                While ((Local0 < Local1))
                {
                    Local2 = DerefOf (ITML [Local0])
                    Local3 = DerefOf (Local2 [Zero])
                    Local4 = DerefOf (Local2 [One])
                    If ((TDVI == Local3))
