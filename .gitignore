# external reference clones (see AGENTS.md §4)
/reference/

# rust
/target/
**/*.rs.bk

# asset pipeline: NVIDIA-derived blobs never enter git (constitution §6)
/assets/in/
/assets/out/
/assets/work/
*.rom
*.bin
gsp_ga10x*
firmware-*.run
nvidia-utils*.tar.*

# keys / decrypted / generated payloads never enter git
*.key
*.pem
payload_*

# qemu runtime artifacts (evidence copies live under docs/evidence/)
/sim/qemu/run/
/sim/qemu/usbroot/

# qemu disk image (test fixture, may contain firmware copies)
/sim/qemu/usb.img

# local IDE / agent session state
/.idea/
/.zcode/

# local release artifacts (only the make-* scripts are tracked; binaries and
# per-run stick roots stay local and are distributed via GitHub Releases)
/release/*.EFI
/release/*.EFI.*
/release/SHA256SUMS*
/release/usbroot*/
/release/v*/
/release/inputs/
/release/assets-tu10x/
/release/assets-x86_64-windows.exe
/release/assets-x86_64-linux
romcore/testdata/

# working drafts (notes and reply drafts, kept local)
/docs/drafts/
